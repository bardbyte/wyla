# ── Vertex AI / Gemini 3.1 Pro (required) ──
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/keys/vertex-sa.json
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=prj-d-ea-poc
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-pro-preview

# ── The target table for this demo ──
TABLE_NAME=custins_customer_insights_cardmember
BQ_PROJECT=axp-lumi
BQ_DATASET=dw

# ── Source inputs (the three folders) ──
# All paths absolute. Output of synapse/sql/bq_table_extraction.sql goes here:
BQ_EXTRACTION_DIR=/Users/you/synapse_bq_outputs/custins_customer_insights_cardmember
# The MDM API response as a single JSON file (the array-wrapped response):
MDM_JSON_PATH=/Users/you/synapse_bq_outputs/custins_customer_insights_cardmember/mdm.json
# Folder with the ~35 real SQL queries that hit this table (one .sql per file):
SQL_QUERIES_DIR=/Users/you/synapse_bq_outputs/custins_customer_insights_cardmember/queries

# ── Outputs (auto-created if missing) ──
GRAPH_CACHE_DIR=./data/cache
ENRICHMENT_MEMORY_PATH=./data/cache/enrichment_memory.json
ENTITY_PROPOSALS_PATH=./data/cache/entity_proposals.json

# ── Enrichment controls ──
# How many columns to enrich per Gemini call.  Lower = more granular evidence
# in each prompt; higher = fewer calls but blurrier reasoning per column.
ENRICHMENT_BATCH_SIZE=20
# Hard cap on Gemini calls per run (cost gate).  Default fine for 190 cols / 20.
ENRICHMENT_MAX_CALLS=20
# Set to 1 to skip the real Gemini calls and use a canned response for dev.
ENRICHMENT_DRY_RUN=0

# ── Optional: BQ dry-run validation tool (skip for v1) ──
# When set, the agent gains a validate_sql tool that runs dry_run=True against BQ.
# BQ_SA_KEY=/Users/you/keys/bq-sa.json
