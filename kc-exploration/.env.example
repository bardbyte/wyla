# Copy to .env (gitignored) and fill in. Every script in this folder reads
# it. Precedence: a shell-exported variable > this file > KC_EXTRA_ENV_FILE
# > the default in code. A file never overrides a variable that is already
# set, and a missing file loads nothing.

# ── The catalog plane: Knowledge Catalog search on its own key ──
# The consumer project: every search is projects/<this>/locations/global.
KC_PROJECT_ID=your-project
# A service-account key with dataplex.projects.search (roles/dataplex.viewer)
# and serviceusage.services.use (roles/serviceusage.serviceUsageConsumer).
# Required: the catalog never borrows the model plane's key.
KC_SA_KEY=/absolute/path/to/catalog-sa-key.json
# The project that carries the quota (sent as X-Goog-User-Project).
# Defaults to KC_PROJECT_ID; "none" sends no header and bills the key's
# own project instead.
# KC_QUOTA_PROJECT=
# Where the search looks: organizations/<id> or projects/<id>. Unset,
# the API searches the organization the consumer project belongs to.
# KC_SEARCH_SCOPE=projects/your-project
# KC_PAGE_SIZE=50                 # rows per search; the cost dial
# KC_SEMANTIC_SEARCH=1            # 0 for keyword-only search
# KC_API_BASE_URL=https://dataplex.googleapis.com
# The catalog is a Google host: it rides HTTPS_PROXY when one is set,
# like the Vertex plane. 1 goes direct. NO_PROXY is never consulted.
# KC_DISABLE_PROXY=0
# KC_CA_BUNDLE=                   # a root certificate, else REQUESTS_CA_BUNDLE / SSL_CERT_FILE
# KC_TLS_INSECURE=0               # last resort; prefer the bundle, or pip install truststore

# ── The agent ──
# KC_MODEL_PLANE=auto             # vertex | gateway | auto (Vertex when configured, else the gateway)
# KC_THINKING_LEVEL=low           # low | medium | high
# KC_MAX_MODEL_CALLS=6            # model calls per question
# KC_WALL_SECONDS=300             # seconds per question

# ── Which files this folder reads ──
# KC_ENV_FILE=                    # this file, when it lives elsewhere
# A second file read after this one, for the model contract below. Inside
# a monorepo that already carries the model contract, point it at that
# file and leave the rest of this one alone:
# KC_EXTRA_ENV_FILE=../synapse-agentic-harness-system/.env

# ── The Vertex plane: Gemini 3.1 Pro Preview on a service-account key ──
# VERTEX_SA_KEY=/absolute/path/to/vertex-sa-key.json     # or SYNAPSE_VERTEX_SA_KEY / GOOGLE_APPLICATION_CREDENTIALS
# VERTEX_PROJECT_ID=your-vertex-project                   # or GOOGLE_CLOUD_PROJECT
# VERTEX_LOCATION=global                                  # or GOOGLE_CLOUD_LOCATION
# VERTEX_MODEL=gemini-3.1-pro-preview                     # or GEMINI_MODEL
# VERTEX_API_BASE_URL=                                    # a private endpoint; else derived from the location
# VERTEX_DISABLE_PROXY=0                                  # 1 goes direct
# GEMINI_CA_BUNDLE=                                       # else REQUESTS_CA_BUNDLE / SSL_CERT_FILE
# GEMINI_TLS_INSECURE=0

# ── The gateway plane: Gemini 2.5 Pro through an enterprise gateway ──
# Both URLs are required on this plane; there are no defaults in code.
# GATEWAY_BASE_URL=https://gateway.example.com/genai/google/v1
# IDP_TOKEN_URL=https://identity.example.com/security/v1/application/token
# AUTH_MODE=generated             # generated: mint from APP_ID + APP_SECRET; env: use GEMINI_BEARER_TOKEN
# APP_ID=
# APP_SECRET=                     # base64; never in source control
# GEMINI_BEARER_TOKEN=            # AUTH_MODE=env only
# AUTH_VERSION=2
# GATEWAY_MODEL=gemini-2.5-pro
# GATEWAY_SCOPES=                 # comma list; default derived: <base path>/models/<model>/**::post
# IDP_TIMESTAMP_UNIT=ms           # or s
# GATEWAY_ROUTE=auto              # direct | proxy | auto (direct first, then the proxy)
# GATEWAY_PATH_FORM=slash         # slash (…/model/generateContent) | colon (…/model:generateContent)
# GATEWAY_CA_BUNDLE=
# GATEWAY_THINKING_BUDGETS=low:1024,medium:4096,high:16384
