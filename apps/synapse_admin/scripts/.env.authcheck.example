# Synapse sign-in preflight: configuration template.
#
#   cp .env.authcheck.example .env.authcheck.local     # git-ignored (.env.*.local)
#   python okta_check.py        --env-file .env.authcheck.local
#   python google_auth_check.py --env-file .env.authcheck.local
#   python ldap_check.py        --env-file .env.authcheck.local
#
# NAME_<ENV> wins over NAME. Values already exported in the shell win over this
# file. Secrets are optional: without them the scripts still prove reachability,
# client registration and callback URLs; with them they also prove the Okta
# id+secret pair, the Google secret, and the LDAP bind.

AUTHCHECK_ENVS=E1,E2,E3

# ---- Okta --------------------------------------------------------------
# Discovery: the issuer (https://<org>.okta.com/oauth2/<authorizationServerId>)
# or the full .well-known URL from the authorization server's settings page.
# Several environments may share one authorization server and one client.
OKTA_DISCOVERY_URL_E1=https://<org>.okta.com/oauth2/<authorization-server-id>
OKTA_CLIENT_ID_E1=
OKTA_REDIRECT_URI_E1=https://<dev-host>/callback
# OKTA_CLIENT_SECRET_E1=

OKTA_DISCOVERY_URL_E2=https://<org>.okta.com/oauth2/<authorization-server-id>
OKTA_CLIENT_ID_E2=
OKTA_REDIRECT_URI_E2=https://<qa-host>/callback
# OKTA_CLIENT_SECRET_E2=

OKTA_DISCOVERY_URL_E3=https://<prod-org>.okta.com/oauth2/<authorization-server-id>
OKTA_CLIENT_ID_E3=
OKTA_REDIRECT_URI_E3=https://<prod-host>/callback
# OKTA_CLIENT_SECRET_E3=

# The scopes the app requests, and the ID-token claim that carries groups.
OKTA_SCOPES=openid profile
# OKTA_GROUP_CLAIM=groups

# --inventory: sign in once through the browser and list every claim. Add
# the local callback to the NON-PRODUCTION client's Login redirect URIs.
# OKTA_LOCAL_REDIRECT_URI=http://localhost:8400/callback
# OKTA_INVENTORY_SCOPES=openid profile email groups

# ---- Google ------------------------------------------------------------
# One OAuth client (type "Web application") usually serves every environment,
# with all callbacks listed under its "Authorized redirect URIs". For
# per-environment clients set GOOGLE_CLIENT_ID_E1 (and _E2, _E3) instead.
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_E1=https://<dev-host>/callback
GOOGLE_REDIRECT_URI_E2=https://<qa-host>/callback
GOOGLE_REDIRECT_URI_E3=https://<prod-host>/callback
# GOOGLE_SCOPES=openid email profile

# --inventory: run the consent once through the browser and list every claim,
# the granted scopes, the refresh token, the Workspace domain, and a BigQuery
# dry run. Add the local callback to the client's Authorized redirect URIs.
# GOOGLE_LOCAL_REDIRECT_URI=http://localhost:8400/callback
# GOOGLE_INVENTORY_SCOPES=openid email profile https://www.googleapis.com/auth/bigquery
# GOOGLE_BQ_PROJECT=              # dry-run "SELECT 1" here (no bytes billed)
# GOOGLE_EXPECTED_HD=             # the Workspace domain the account must belong to

# ---- LDAP --------------------------------------------------------------
# Same names the deployment uses, suffixed per environment.
LDAP_SERVER_E1=ldaps://<host>:636
LDAP_BASE_DN_E1=OU=...,DC=...,DC=...
LDAP_USER_E1=<service-account>
LDAP_PASSWORD_E1=
# LDAP_BIND_DN_E1=          # exact bind identity, if the plain user name is refused
# LDAP_LOOKUP_E1=           # an end-user account to search for (default: the bind user)
# LDAP_GROUPS_PREFIX=Sem-   # --inventory: list the groups named like this, with member counts

LDAP_SERVER_E2=ldaps://<host>:636
LDAP_BASE_DN_E2=OU=...,DC=...,DC=...
LDAP_USER_E2=<service-account>
LDAP_PASSWORD_E2=

LDAP_SERVER_E3=ldaps://<host>:636
LDAP_BASE_DN_E3=OU=...,DC=...,DC=...
LDAP_USER_E3=<service-account>
LDAP_PASSWORD_E3=

# Corporate root CA: LDAPS certificates are usually signed by an internal CA,
# and on a proxied laptop the HTTPS checks may need it too.
# LDAP_CA_CERT=/path/to/corporate-root.pem
# AUTHCHECK_CA_BUNDLE=/path/to/corporate-root.pem
# Last resort, and loud:  LDAP_TLS_INSECURE=1   AUTHCHECK_TLS_INSECURE=1
