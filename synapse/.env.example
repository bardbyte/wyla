# ───────────────────────────────────────────────────────────────────────
# synapse .env  —  copy to `synapse/.env` and fill in. NEVER commit.
#
# Loaded automatically by every script in synapse/scripts/. Anything you
# already `export`ed in the shell wins over what's here.
#
# Two-SA-key pattern: Vertex (LLM) and BigQuery use different SAs with
# different perms in different projects. If you only have one SA that
# can do both, set GOOGLE_APPLICATION_CREDENTIALS instead and skip the
# two _SA_KEY vars.
# ───────────────────────────────────────────────────────────────────────


# ═══ Vertex AI (Gemini, for entity curation) ═══════════════════════════

# Path to the Vertex SA key JSON. Place OUTSIDE this repo.
LUMI_VERTEX_SA_KEY=/Users/you/.gcp/synapse-vertex-sa.json

# GCP project that owns the Gemini grant
LUMI_VERTEX_PROJECT=prj-d-ea-poc

# Vertex region — 'global' is the right answer for prj-d-ea-poc
LUMI_VERTEX_LOCATION=global

# Optional: override the model
# LUMI_VERTEX_MODEL=gemini-3.1-pro-preview


# ═══ BigQuery (where the 56 tables actually live) ══════════════════════

# Path to the BQ SA key JSON
LUMI_BQ_SA_KEY=/Users/you/.gcp/synapse-bq-sa.json

# REQUIRED — the BQ project the script runs jobs UNDER.
# This is the project in `jobs.insert` paths. It can DIFFER from the
# project that owns the data, as long as the SA has:
#   - roles/bigquery.jobUser in BQ_PROJECT_ID
#   - roles/bigquery.dataViewer (or equivalent) in the data project(s)
BQ_PROJECT_ID=prj-p-lumi-gpt

# Fallback — synapse looks at LUMI_BQ_PROJECT if BQ_PROJECT_ID isn't set
# LUMI_BQ_PROJECT=prj-p-lumi-gpt

# Default dataset for unqualified table names
LUMI_BQ_DATASET=dw

# BQ region for jobReference.location — must match where your data lives
BQ_LOCATION=US

# REST endpoint override. Leave unset for public Google endpoint.
# Use this when behind enterprise gateway:
#   - https://bigquery-dev.p.googleapis.com    (dev gateway)
#   - https://bigquery-prod.p.googleapis.com   (prod gateway)
# BIGQUERY_API_BASE_URL=https://bigquery-prod.p.googleapis.com

# Fallback endpoint var (legacy name)
# BIGQUERY_URL=https://bigquery-prod.p.googleapis.com


# ═══ Legacy single-key fallback ═══════════════════════════════════════
#
# If you have ONE SA that can do both Vertex AND BQ, set this and leave
# LUMI_VERTEX_SA_KEY / LUMI_BQ_SA_KEY blank. The resolver falls back to
# this whenever a service-specific key isn't set.
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.gcp/single-key.json


# ═══ Corporate-network plumbing (only if you're behind a proxy) ════════

# Set to 1 if your network REQUIRES the proxy for Google traffic and
# you don't want synapse merging Google hosts into NO_PROXY.
# BQ_FORCE_PROXY=0

# Set to 1 if the OAuth token refresh keeps failing with 407 — this
# tells the auth Session to ignore the shell's proxy env vars.
# BQ_DISABLE_PROXY=1

# Standard NO_PROXY env var. Synapse MERGES Google hosts into this
# automatically (unless BQ_FORCE_PROXY=1). You can pre-populate it
# with your own bypass list and synapse will add to it.
# NO_PROXY=localhost,127.0.0.1,.internal.aexp.com

# Custom CA bundle for corporate TLS interception. Set REQUESTS_CA_BUNDLE
# directly, OR set SSL_CERT_FILE and synapse mirrors it.
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/your-corp-ca-bundle.pem
# SSL_CERT_FILE=/etc/ssl/certs/your-corp-ca-bundle.pem


# ═══ Common Google library env vars (usually no need to touch) ═════════
# GOOGLE_GENAI_USE_VERTEXAI=true   # synapse sets this automatically
# GOOGLE_CLOUD_PROJECT=...          # only as last-resort fallback
