# Profile: local — a laptop. Copy to env/local.env and fill in.
# Selected with SAHS_ENV_FILE=env/local.env (make run ENV=local).
# Placeholders only: <...> is yours to replace. Shell exports win.

# ── the store: people and chats in one local sqlite file, no Spanner ──
SAHS_STORE=sqlite
SAHS_IDENTITY_SQLITE=graph/runs/identity.sqlite3
# the email-and-password door (sign-up, login, reset) is open on a laptop
AUTH_LOCAL_LOGIN=1
AUTH_PEPPER=<at-least-eight-characters-never-a-real-one-here>
AUTH_COOKIE_SECURE=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=<you@example.com>
AUTH_OPEN_SIGNUP=1
AUTH_DEFAULT_ROLE=analyst
AUTH_ALLOW_INSECURE_DIRECT_RESET=0
SYNAPSE_USER_NAME=<Your Name>

# ── the build and the data: this disk ──
MERIDIAN_BUILDS_SOURCE=local
MERIDIAN_SOURCES_DIR=<path-to>/sources
MERIDIAN_GRAPH_DIR=
MERIDIAN_BUILDS_DIR=

# ── the model plane: Vertex on the laptop, or the gateway ──
SAHS_MODEL_PLANE=auto
SYNAPSE_VERTEX_SA_KEY=<path-to>/vertex-sa-key.json
VERTEX_PROJECT_ID=<vertex-project>
VERTEX_MODEL=<vertex-model-name>
# the gateway plane, when a laptop rides it instead (both hosts are required)
# AUTH_MODE=generated
# APP_ID=<app-id>
# APP_SECRET=<base64-secret>
# AUTH_VERSION=2
# GATEWAY_MODEL=<gateway-model-name>
# IDP_TOKEN_URL=https://<identity-service-host>/security/digital/v1/application/token
# GATEWAY_BASE_URL=https://<gateway-host>/genai/google/v1

# ── BigQuery as the service account (a dry run without it is still a dry run) ──
SAHS_BQ_AUTH_MODE=service_account
SYNAPSE_BQ_SA_KEY=<path-to>/bq-sa-key.json
SYNAPSE_BQ_PROJECT=<bq-query-project>
SYNAPSE_BQ_DATA_PROJECT=<bq-data-project>
SAHS_ALLOW_LIVE=0

# ── off on a laptop ──
SAHS_LANGFUSE=0
