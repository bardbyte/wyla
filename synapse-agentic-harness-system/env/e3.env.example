# Profile: e3 — production. Copy to env/e3.env and fill in.
# Selected with SAHS_ENV_FILE=env/e3.env (make run ENV=e3).
# Placeholders only: <...> is yours to replace; never a real host, key
# or secret in this example. Shell exports win over the file.
# AUTH_LOCAL_LOGIN is deliberately absent: the only door is Okta, and
# `make check ENV=e3` refuses a file that sets it.

EPAAS_ENV=e3

# ── the store: one Spanner database for this environment ──
SAHS_STORE=spanner
SPANNER_PROJECT_ID=<gcp-project>
SPANNER_INSTANCE_ID=<spanner-instance>
SPANNER_DATABASE_ID=<spanner-database-e3>
SPANNER_URL=https://<private-spanner-endpoint>
SAHS_SPANNER_ENDPOINT_E3=https://<private-spanner-endpoint>
SYNAPSE_SPANNER_SA_KEY=<path-to>/spanner-sa-key.json
SPANNER_FORCE_PROXY=0

# ── sign-in: Okta only ──
AUTH_PEPPER=<32-or-more-random-characters-from-the-secret-store>
AUTH_SESSION_HOURS=12
AUTH_IDLE_MINUTES=30
AUTH_COOKIE_SECURE=auto
AUTH_BOOTSTRAP_ADMIN_EMAIL=<first-admin@example.com>
AUTH_OPEN_SIGNUP=0
AUTH_DEFAULT_ROLE=analyst
AUTH_ALLOW_INSECURE_DIRECT_RESET=0
OKTA_ISSUER=https://<org>.okta.com/oauth2/<authorization-server-id>
OKTA_CLIENT_ID=<okta-client-id-e3>
OKTA_CLIENT_SECRET=<okta-client-secret-e3>
OKTA_REDIRECT_URI=https://<e3-host>/callback
OKTA_SCOPES=openid profile
OKTA_GROUP_CLAIM=groups
AUTH_GROUP_ROLE_MAP=<admin-group>=admin,<steward-group>=steward,*=analyst
AUTH_EMAIL_CLAIMS=email,preferred_username
SYNAPSE_ALLOWED_ORIGINS=
SYNAPSE_HEALTH_ALIAS=

# ── the model plane: the gateway behind an identity-service token ──
SAHS_MODEL_PLANE=gateway
AUTH_MODE=generated
APP_ID=<app-id-e3>
APP_SECRET=<base64-secret-e3>
AUTH_VERSION=2
GATEWAY_MODEL=<gateway-model-name>
GATEWAY_MODELS=<gateway-model-name>
GATEWAY_ROUTE=auto
IDP_TOKEN_URL=https://<identity-service-host>/security/digital/v1/application/token
GATEWAY_BASE_URL=https://<gateway-host>/genai/google/v1
SAHS_OAUTH_TOKEN_ENDPOINT_E3=https://<enterprise-oauth-token-endpoint>
SAHS_VERTEX_ENDPOINT_E3=https://<private-vertex-endpoint>

# ── the promoted build from Spanner, not a disk ──
MERIDIAN_BUILDS_SOURCE=spanner
MERIDIAN_BUILD_CACHE_DIR=<writable-cache-dir>
MERIDIAN_BUILDS_REFRESH_SECONDS=300

# ── BigQuery: as the person (their connected Google account) ──
SAHS_BQ_AUTH_MODE=user
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://<e3-host>/callback
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=<fernet-key-from-the-secret-store>
SYNAPSE_BQ_PROJECT=<bq-query-project>
SYNAPSE_BQ_DATA_PROJECT=<bq-data-project>
SAHS_ALLOW_LIVE=1
SAHS_LIVE_MAX_BYTES=1000000000

# ── the enterprise network names ──
SAHS_CA_PACKAGE=<importable-certificate-package>
SAHS_SECRETS_DIR=<secret-mount-path>

# ── the mirror of the record ──
SAHS_LANGFUSE=0
SAHS_LANGFUSE_ENV=e3
