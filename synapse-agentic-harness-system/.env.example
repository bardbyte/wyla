# Copy to .env (gitignored) and fill in. Loaded by pipeline.py, the
# checks, AND the Synapse app (uvicorn) — shell-exported variables
# always win over this file.

# ── BigQuery (PSC endpoint: a DIRECT route, pinned on the connection;
#    the environment's NO_PROXY is neither read nor written) ──
# SYNAPSE_BQ_SA_KEY=/absolute/path/to/bq-sa-key.json
# SYNAPSE_BQ_PROJECT=your-bq-project            # runs and bills the query
# SYNAPSE_BQ_API_BASE_URL=https://bigquery.yourcompany.com
# The project that HOSTS the tables when it is not SYNAPSE_BQ_PROJECT: the
# graph names tables dataset.table (dw.gms_transaction) and the sandbox
# qualifies them with this project before every dry run or execution.
# Check it once with: python scripts/bq_check.py --table dw.gms_transaction
# SYNAPSE_BQ_DATA_PROJECT=demo-warehouse
# The dataset's location, if regional (US is the default):
# BQ_LOCATION=US

# ── Vertex (chat + enrichment: rides HTTPS_PROXY, pinned on the
#    connection, so a BigQuery call never reroutes a model call) ──
# SYNAPSE_VERTEX_SA_KEY=/absolute/path/to/vertex-sa-key.json
# VERTEX_PROJECT_ID=your-vertex-project
# VERTEX_MODEL=gemini-3.1-pro-preview

# ── Paths (pipeline.py, graph_state.py, AND the Synapse app) ──
# Paste once; every command picks them up. Precedence everywhere:
# CLI flag > shell-exported variable > this file > silo default.
# Passing an empty flag value (e.g. --bq-archive "") skips that
# archive for one run even when the .env carries it.
# MERIDIAN_SOURCES_DIR=/Users/you/data/sources
# The skills tree the Artifacts shelf walks (areas = subfolders,
# nesting welcome: CFR/<skill>, CFR/TLS/<semantics>). Defaults to
# <sources>/skills when unset:
# MERIDIAN_SKILLS_DIR=/Users/you/data/skills
# How much of a skill the agent reads, and how many one chat loads.
# The defaults keep a skill a briefing (4,000 characters) and a chat
# to four. Full runtime knowledge bundles need the ceiling raised;
# a skill over it is listed but REFUSES to load, by name — nothing
# is ever truncated in silence:
# SAHS_MAX_SKILL_CHARS=220000
# SAHS_MAX_LOADED_SKILLS=4
# MERIDIAN_BQ_ARCHIVE=/Users/you/data/real_extractions_production
# MERIDIAN_MDM_ARCHIVE=/Users/you/data/mdm_46_patched_v2
# MERIDIAN_REGISTRY=/Users/you/data/real_extractions_production/_batch_summary.csv
# Defaults to <graph>/identity/crosswalk.jsonl when unset:
# MERIDIAN_CROSSWALK=
# Default to this silo's graph/ and builds/ when unset:
# MERIDIAN_GRAPH_DIR=
# MERIDIAN_BUILDS_DIR=
# Synapse app only — where the silo itself lives, if not adjacent:
# MERIDIAN_SILO_DIR=
# Knowledge Catalog enrichment: the config file (project, location,
# glossary, the enabled tables, aspect-type ids). Defaults to
# <silo>/config/kc.yaml; docs/kc.md is the runbook.
# KC_CONFIG=

# ── Chat (Synapse v3): the model plane ──
# Which plane the chat's model calls ride. vertex = Gemini 3.1 Pro
# Preview on Vertex (the SA key); gateway = Gemini 2.5 Pro through the
# gateway behind an identity-service token (APP_ID / APP_SECRET below);
# auto, the default, lands on vertex whenever the Vertex contract above
# is present and falls back to gateway only when the gateway alone is
# configured. The gateway serves no stream: each model call lands
# whole. python scripts/turn_doctor.py names the plane; python
# scripts/planes_check.py proves it.
# SAHS_MODEL_PLANE=auto
# That is the plane a NEW chat starts on. The composer's model switch
# picks the other plane for one chat (remembered on it); the "?" beside
# the dials explains Quick/Standard/Deep.
# Thinking on 2.5 is a token budget per depth (Quick / Standard / Deep),
# and the client raises the output cap by the budget:
# GATEWAY_THINKING_BUDGETS=low:1024,medium:4096,high:16384
# GATEWAY_JSON_THINKING_BUDGET=512          # the judge, the title, the memory pass

# ── Chat (Synapse v3): memory is bound to the person ──
# The name the memory section addresses ("What you remember about
# Saheb Singh"); the account block in the app shows the same name:
# SYNAPSE_USER_NAME=Saheb Singh
# The same name says whose own skills load (graph/skills/users/<name>/)
# until sign-in names the person.

# ── Skills and knowledge files go to the manager first (the approval
#    workflow: docs/runbooks/laptop_end_to_end.md) ──
# The submitter's direct manager approves or rejects every skill and
# knowledge file a person brings in; nobody picks their own approver.
# On a laptop the directory is this file: the manager's name and band
# (40 or above may approve). Unset, the configured person reviews
# their own submissions and every record says so.
# SYNAPSE_USER_MANAGER=Jane Doe
# SYNAPSE_USER_MANAGER_BAND=40
# SYNAPSE_USER_BAND=40                    # your own band, for the self-review case

# ── Leaving the laptop: people and chats on Spanner (docs/spanner_schema.md §6) ──
# The identity store (sahs/identity, db/spanner/001_identity.sql) reads
# these through sahs/util/spanner/settings.py; under spanner a missing
# required one refuses to start, never falls back to local. The pepper
# and the key are never printed.
# SAHS_STORE=local                       # local | spanner | sqlite (the block below)
# SPANNER_PROJECT_ID=your-gcp-project
# SPANNER_INSTANCE_ID=synapse
# SPANNER_DATABASE_ID=synapse
# SPANNER_URL=https://spanner.googleapis.com   # a private endpoint on the corporate
#                                               # network; direct route, like BigQuery
#                                               # (SPANNER_API_BASE_URL is the same setting)
# SPANNER_FORCE_PROXY=1                          # ride HTTPS_PROXY instead (not the default)
# SYNAPSE_SPANNER_SA_KEY=/absolute/path/to/spanner-sa-key.json   # roles/spanner.databaseUser: a path,
#                                        # inline JSON, or base64 JSON; GOOGLE_APPLICATION_CREDENTIALS
#                                        # is read second; unset on a host with workload identity
# SPANNER_EMULATOR_HOST=localhost:9010   # development against the emulator only
# SPANNER_OWNER_USER_ID=                 # the person the builds-from-Spanner store writes as
# AUTH_PEPPER=                           # 8 characters at least; 32+ random ones in a deployment:
#                                        # python -c "import secrets; print(secrets.token_urlsafe(48))"
#                                        # never in source control; never changed in place once anyone has a password
# AUTH_SESSION_HOURS=12                  # the absolute life of a sign-in
# AUTH_IDLE_MINUTES=30                   # the idle expiry, pushed forward on use
# AUTH_COOKIE_SECURE=auto                # auto (Secure over https) | true | false (http://localhost only)
# AUTH_BOOTSTRAP_ADMIN_EMAIL=you@yourcompany.com   # the sign-up with this address is the first admin
# AUTH_OPEN_SIGNUP=1                     # 1: anyone may sign up (as AUTH_DEFAULT_ROLE); 0: only the
#                                        # bootstrap address, everyone else created by an admin
# AUTH_ALLOWED_EMAIL_DOMAINS=            # comma list; when set, sign-up accepts only these domains
# AUTH_DEFAULT_ROLE=analyst              # analyst opens /synapse/; admin opens / and /synapse/
# AUTH_LOCK_AFTER=5                      # wrong passwords before the account locks
# AUTH_LOCK_MINUTES=15                   # the first lock; doubles each further lock, capped at a day
# SAHS_FILES_DIR=                        # a chat's file bytes under spanner: a host folder (default: the
#                                        # workspace folder, as today) or gs://bucket/prefix

# ── Ask (E18): the agentic chat loop ──
# Both are required before Ask executes for real; without them every
# query is a dry run that returns zero rows by design:
# The chat runs queries for rows (run_sql mode run) only when live
# execution is on, and then under two limits the model cannot lift:
# the scan ceiling in bytes (a query priced above it is refused with
# a partition-filter hint) and the row cap (limit, at most 1000).
# SAHS_ALLOW_LIVE=1                    # the name matters: SAHS_LIVE=1 does nothing;
#                                      # read on the next run, no restart needed
# SAHS_LIVE_MAX_BYTES=10000000000      # 10 GB; the silo default is 1 GB
# ASK_EXECUTE=live
# Budget meter pricing, dollars per million tokens. Unset and the
# meter reports tokens rather than inventing a price:
# SYNAPSE_COST_IN=
# SYNAPSE_COST_OUT=


# ── The second surface (Synapse Semantic Intelligence, /synapse/) ──
# An image file on this machine replaces the words in the left header:
# png, jpg, svg, webp or gif. Read on the next app start.
# SYNAPSE_LOGO=/Users/you/Pictures/synapse-logo.png

# ── Gemini 2.5 Pro through the gateway with an identity-service token (a candidate
#    to replace the Vertex plane; validate first: python scripts/gateway_check.py)
# AUTH_MODE=generated                # or env, with GEMINI_BEARER_TOKEN set
# APP_ID=<your-app-id>
# APP_SECRET=<your-base64-secret>     # never in source control
# GEMINI_BEARER_TOKEN=                # AUTH_MODE=env: an existing token
# AUTH_VERSION=2
# GATEWAY_MODEL=gemini-2.5-pro           # not GEMINI_MODEL: the Vertex plane
#                                    # reads that name as a fallback
# THINKING_BUDGET=1056
# SHOW_THOUGHTS=true
# IDP_TOKEN_URL=https://oneidentityapi-dev.aexp.com/security/digital/v1/application/token
# GATEWAY_BASE_URL=https://eag-dev.aexp.com/genai/google/v1
# GATEWAY_SCOPES=                         # comma list; default: the guide's four
# IDP_TIMESTAMP_UNIT=ms             # or s; the check tries both and reports
# GATEWAY_ROUTE=auto                      # direct | proxy | auto (direct first)
# GATEWAY_PATH_FORM=auto                  # slash (the guide's …/generateContent, the gateway's
#                                    # path-pattern scopes) | colon (Google's
#                                    # …:generateContent) | auto (slash first)
# GATEWAY_CA_BUNDLE=                      # the corporate root, if truststore is not installed


# ── Langfuse (the mirror of the record: traces, datasets, runs) ──
# Off unless the switch is on; the product never reads Langfuse back.
# The runbook is docs/runbooks/langfuse.md.
# SAHS_LANGFUSE=1
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000     # LANGFUSE_HOST on older SDKs
# Tool results carry real warehouse rows: spans keep the compact summary
# unless this is on.
# SAHS_LANGFUSE_FULL_RESULTS=0
# A tag on every trace (laptop, ci, ...), so environments separate.
# SAHS_LANGFUSE_ENV=laptop

# ── The identity service: sign-in, sessions, roles, the audit ──
# SAHS_STORE picks where people live. local (the default) is the
# single-developer mode: no sign-in, the app runs as you. spanner is the
# deployment (the SPANNER_* block above). sqlite is a stand-in for a
# laptop or a test: the same tables in one local file, no Spanner needed.
# SAHS_STORE=sqlite
# SAHS_IDENTITY_SQLITE=graph/runs/identity.sqlite3
# AUTH_LOCAL_LOGIN=0                     # 1: the email-and-password routes answer (sign-up, login,
#                                        #    reset). Off by default: the front door is Okta.
# AUTH_ALLOW_INSECURE_DIRECT_RESET=0     # 1: /api/auth/reset-password resets without an email
#                                        #    check (loopback only in e1/e2/e3); never in production
# SYNAPSE_ALLOWED_ORIGINS=               # comma list of browser origins allowed cross-origin
#                                        #    (empty: same-origin only, which the served frontends are)
# SYNAPSE_HEALTH_ALIAS=                  # a second health path the platform probes, e.g. /svc/health

# ── Okta sign-in (OIDC, authorization code + PKCE) ──
# OKTA_ISSUER=https://<org>.okta.com/oauth2/<authorization-server-id>
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# OKTA_REDIRECT_URI=https://<host>/callback      # must be registered on the client
# OKTA_SCOPES=openid profile                     # add the custom scope the server grants
# OKTA_GROUP_CLAIM=groups                        # the ID-token claim carrying group names
# AUTH_GROUP_ROLE_MAP=                           # "<group>=admin,<group>=steward,*=analyst"
# AUTH_EMAIL_CLAIMS=email,preferred_username     # where the email is read from, in order

# ── User-delegated BigQuery: the Google account a person connects ──
# SAHS_BQ_AUTH_MODE=service_account       # service_account (the SVC-ID key) | user (each person's
#                                         #    connected Google account; live runs need a connection)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://<host>/api/auth/google/callback   # must be registered on the client;
#                                         #    never localhost in a deployed environment
# GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=      # a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GOOGLE_OAUTH_POST_CONNECT_URI=/synapse-admin/#/account?google=connected
# (the scopes are fixed in code: openid, email, userinfo.email, bigquery; the consent flow needs exactly these)

# ── The promoted build from Spanner instead of this disk ──
# MERIDIAN_BUILDS_SOURCE=local            # local (MERIDIAN_BUILDS_DIR) | spanner (the promoted bundle)
# MERIDIAN_BUILD_CACHE_DIR=               # where a Spanner-sourced build is unpacked (default: the OS cache dir)
# MERIDIAN_BUILDS_REFRESH_SECONDS=300     # how often a pod re-checks which build is promoted

# ── Enterprise network names, kept out of this public repository ──
# The enterprise build hard-codes these; here each comes from the environment.
# SAHS_CA_PACKAGE=                        # an importable package exposing certificate_path()
# SAHS_SECRETS_DIR=                       # the secret mount holding key.json / ca-bundle.crt
# EPAAS_ENV=                              # e1 | e2 | e3: selects the per-environment endpoints below
# SAHS_VERTEX_ENDPOINT_E1=                # (and _E2, _E3) the private Vertex endpoint per environment
# SAHS_OAUTH_TOKEN_ENDPOINT_E1=           # (and _E2, _E3) the enterprise OAuth token endpoint
# SAHS_SPANNER_ENDPOINT_E1=               # (and _E2, _E3) the private Spanner endpoint
